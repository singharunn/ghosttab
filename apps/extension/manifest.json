{
  "manifest_version": 3,
  "name": "GhostTab",
  "version": "0.1.0",
  "description": "Your tabs. Your spaces. Your privacy. A local-first browser workspace and session manager.",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "GhostTab Workspace Manager",
    "default_popup": "popup.html",
    "default_icon": "assets/icon-128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Alt+G",
        "mac": "Command+Option+G"
      },
      "description": "Open GhostTab dashboard"
    },
    "save-session": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save current session as a capsule"
    },
    "search-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Search all saved tabs and workspaces"
    }
  }
}
