{
  "name": "@ghosttab/storage",
  "version": "0.1.0",
  "type": "module",
  "description": "IndexedDB and chrome.storage abstractions for GhostTab",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./indexeddb": "./src/adapters/indexeddb.ts",
    "./chrome": "./src/adapters/chrome.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@ghosttab/core": "workspace:*",
    "zod": "^3.22.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "storage",
    "indexeddb",
    "chrome-storage",
    "local-first",
    "persistence"
  ]
}
