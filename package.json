{
  "name": "ghosttab",
  "version": "0.1.0",
  "description": "Privacy-first browser workspace and session manager. Your tabs. Your spaces. Your privacy.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter=./apps/* --filter=./packages/* dev",
    "build": "pnpm --filter=./apps/* --filter=./packages/* build",
    "preview": "pnpm --filter=./apps/web preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "type-check": "tsc --noEmit"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
